# ============================================================
# API Doc Sentinel — Variáveis de Ambiente
# ATENÇÃO: Copie este arquivo para .env e preencha os valores
# NUNCA envie o arquivo .env para o GitHub!
# ============================================================

# === Google Gemini (obtenha em: https://aistudio.google.com) ===
GOOGLE_API_KEY=inserir_api_key_aqui

# === Configuração do Banco de Dados ===
# Para desenvolvimento: SQLite (arquivo local, sem servidor)
DATABASE_URL=sqlite:///./sentinel.db
# Para produção futura: descomente e configure o PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/sentinel_db

# === Notificação por E-mail (Gmail) ===
# ATENÇÃO: Use uma "Senha de App" do Google, NÃO sua senha normal!
# Como gerar: Google Account > Segurança > Verificação em 2 etapas > Senhas de app
EMAIL_SENDER=remetente@dominio.com
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_RECIPIENT=destinatario@dominio.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# === Configurações do Agente ===
# Modelo do Gemini (opções: gemini-2.0-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.0-flash

# === Configurações do Scheduler ===
# Intervalo padrão de checagem em minutos (1440 = uma vez por dia)
DEFAULT_CHECK_INTERVAL_MINUTES=1440
